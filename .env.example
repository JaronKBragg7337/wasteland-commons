# Browser build (Vite only exposes VITE_* values to the client).
VITE_RELAY_URL=ws://localhost:8787

# Server-only persistence. Never put this key in VITE_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# When both server-only values are set and the dedicated migrations are applied,
# the WebSocket function uses a private Realtime room and a database lease.
