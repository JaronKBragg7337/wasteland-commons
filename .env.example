# Browser build (Vite only exposes VITE_* values to the client).
VITE_RELAY_URL=ws://localhost:8787

# Server-only persistence. Never put either key in VITE_* variables.
SUPABASE_URL=
# Preferred current Supabase server-only key.
SUPABASE_SECRET_KEY=
# Legacy fallback accepted during the Supabase key transition.
SUPABASE_SERVICE_ROLE_KEY=
# When SUPABASE_URL plus either server-only key is set and the dedicated migrations are applied,
# the WebSocket function uses a private Realtime room and a database lease.
